{
  "manifest_version": 3,
  "name": "Inres",
  "version": "7.0.1",
  "version_name": "7.0.1",
  "description": "Auto-scroll, Picture-in-Picture, background audio, and translucent scrub controls for Instagram Reels.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inres",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content.css"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
